<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.siyan1234.itproject2nd.News.dao.NewsDao">

    <select id="findMainNews" resultType="com.siyan1234.itproject2nd.News.dto.NewsDto">
        SELECT
        NEWS_ID AS id,
        TITLE AS title,
        SUMMARY AS summary,
        SOURCE AS source,
        PUBLISHED_AT AS publishedAt,
        LINK AS link
        FROM NEWS
        ORDER BY NEWS_ID DESC
    </select>

</mapper>
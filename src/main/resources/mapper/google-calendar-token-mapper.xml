<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.siyan1234.itproject2nd.calendar.dao.GoogleCalendarTokenDao">

    <!-- ========================= -->
    <!-- GoogleCalendarTokenDto 결과 매핑 -->
    <!-- ========================= -->
    <resultMap id="GoogleCalendarTokenResultMap"
               type="com.siyan1234.itproject2nd.calendar.dto.GoogleCalendarTokenDto">

        <id property="no" column="NO"/>
        <result property="memberNo" column="MEMBER_NO"/>
        <result property="accessToken" column="ACCESS_TOKEN"/>
        <result property="refreshToken" column="REFRESH_TOKEN"/>
        <result property="tokenExpiry" column="TOKEN_EXPIRY"/>
        <result property="googleEmail" column="GOOGLE_EMAIL"/>
        <result property="regdate" column="REGDATE"/>
    </resultMap>


    <!-- ========================= -->
    <!-- 회원 번호로 구글 토큰 조회 -->
    <!-- ========================= -->
    <select id="findByMemberNo"
            resultMap="GoogleCalendarTokenResultMap">

        SELECT
        NO,
        MEMBER_NO,
        ACCESS_TOKEN,
        REFRESH_TOKEN,
        TOKEN_EXPIRY,
        GOOGLE_EMAIL,
        REGDATE
        FROM GOOGLE_CALENDAR_TOKEN
        WHERE MEMBER_NO = #{memberNo}

    </select>


    <!-- ========================= -->
    <!-- 구글 토큰 처음 저장 -->
    <!-- ========================= -->
    <insert id="insertToken"
            parameterType="com.siyan1234.itproject2nd.calendar.dto.GoogleCalendarTokenDto">

        INSERT INTO GOOGLE_CALENDAR_TOKEN
        (
        MEMBER_NO,
        ACCESS_TOKEN,
        REFRESH_TOKEN,
        TOKEN_EXPIRY,
        GOOGLE_EMAIL
        )
        VALUES
        (
        #{memberNo},
        #{accessToken, jdbcType=VARCHAR},
        #{refreshToken, jdbcType=VARCHAR},
        #{tokenExpiry, jdbcType=TIMESTAMP},
        #{googleEmail, jdbcType=VARCHAR}
        )

    </insert>


    <!-- ========================= -->
    <!-- 기존 구글 토큰 갱신 -->
    <!-- ========================= -->
    <update id="updateToken"
            parameterType="com.siyan1234.itproject2nd.calendar.dto.GoogleCalendarTokenDto">

        UPDATE GOOGLE_CALENDAR_TOKEN
        SET
        ACCESS_TOKEN = #{accessToken, jdbcType=VARCHAR},
        REFRESH_TOKEN = #{refreshToken, jdbcType=VARCHAR},
        TOKEN_EXPIRY = #{tokenExpiry, jdbcType=TIMESTAMP},
        GOOGLE_EMAIL = #{googleEmail, jdbcType=VARCHAR}
        WHERE MEMBER_NO = #{memberNo}

    </update>


    <!-- ========================= -->
    <!-- 구글 캘린더 연동 해제 -->
    <!-- ========================= -->
    <delete id="deleteByMemberNo">

        DELETE FROM GOOGLE_CALENDAR_TOKEN
        WHERE MEMBER_NO = #{memberNo}

    </delete>

</mapper>